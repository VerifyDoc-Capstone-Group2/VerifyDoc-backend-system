# Use a dedicated database named VerifyDoc_test when running integration tests.
MONGODB_URI=mongodb+srv://username:password@cluster.example/VerifyDoc_test
# Public website where scanned QR codes open the verification page.
FRONTEND_URL=https://verifydoc.example
# Generate a random secret of at least 32 characters; never commit the real value.
QR_VERIFICATION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
